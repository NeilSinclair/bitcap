# Copy to `.env` and fill in the three AUTH_ values; uncomment the rest as you
# need them.
#
#   cp .env.example .env
#
# Keys are commented rather than left blank on purpose. The loader in
# `app/db.py` does `os.environ.setdefault(key, value)`, so `KEY=` sets an empty
# string rather than leaving the variable unset — and empty is not the same as
# absent. `AUTH_TOKEN_HOURS=` raises on `float("")`, and a blank
# `FRONTEND_ORIGIN` overrides the localhost default and blocks every origin.

# --- Required for the quickstart ---------------------------------------------

# Commented out, the database falls back to a local sqlite file (`bitcap.db`).
# Uncomment for the Postgres that `docker compose up -d` serves, which is what
# production runs.
#DATABASE_URL=postgresql+psycopg://bitcap:bitcap@localhost:5432/bitcap

# The single account behind the whole site. Without these, every API route
# returns 503 "authentication is not configured" and the dashboard renders
# nothing — `bitcap-db rebuild` still works, but you cannot look at what it
# built. Generate the hash and secret with `uv run python -m api.auth`.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# --- Needed to run the pipeline, not to read the committed corpus ------------

# Classification and the gold-set drift check. `bitcap-db rebuild` needs none of
# this; `bitcap-worker` classifies nothing without it.
#ANTHROPIC_API_KEY=

# Embeddings for the duplicate collapse, and the repository relevance filter.
# Absent, both fail open: the collapse runs its free deterministic passes and
# reports `dedupe.coverage: 0`, and the releases leg watches an ungated star
# ranking. `alerts.dedupe_unavailable` and `alerts.repo_filter_unavailable`
# are what say so.
#OPENAI_API_KEY=

# The github and releases legs. Absent, both fail as sources; the firing still
# succeeds and the other legs are unaffected.
#GITHUB_TOKEN=

# The posts leg, same isolation as above.
#X_BEARER_TOKEN=

# --- Optional ----------------------------------------------------------------

# Only read when `alerts.channel` in config/pipeline.yaml is `webhook`.
#ALERT_WEBHOOK_URL=

# Session lifetime in hours. Default 12. Must not be blank if set.
#AUTH_TOKEN_HOURS=12

# Deployment only: the API's CORS allow-list, set to the static site's URL.
# Leave commented locally — the default is http://localhost:3000, and a blank
# value overrides it and blocks everything.
#FRONTEND_ORIGIN=
